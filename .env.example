# Copy to .env and replace every secret. Never commit .env.
# python scripts/generate_env.py will create .env with fresh secrets.

APP_PASSWORD=replace-with-a-long-password
SECRET_KEY=replace-with-a-long-random-string
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Azure app registration (personal accounts, public client / device code).
MICROSOFT_CLIENT_ID=

# sqlite file is created automatically. Use an absolute path in production.
DATABASE_URL=sqlite:///./data/sniper.db

# 1 runs the monitor inside the web process. Set 0 if you run python -m app.worker.
RUN_WORKER=1
HOST=127.0.0.1
PORT=8000

# Set to 1 when the site is served over HTTPS.
SECURE_COOKIES=0

# About 10 accounts is the intended size. Values above 50 are clamped to 50.
MAX_ACCOUNTS=25
